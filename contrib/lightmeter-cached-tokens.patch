diff --git a/pricing/cached_lampo_test.go b/pricing/cached_lampo_test.go
new file mode 100644
index 0000000..2707031
--- /dev/null
+++ b/pricing/cached_lampo_test.go
@@ -0,0 +1,23 @@
+package pricing
+
+import "testing"
+
+// Lampo: cached-input permille is the upstream ratio rounded up, clamped.
+func TestCachedPermille(t *testing.T) {
+	cases := []struct {
+		in, cached float64
+		want       int64
+	}{
+		{3, 0.3, 100},      // Kimi K3: a tenth
+		{0.13, 0.028, 216}, // DeepSeek V4 Flash: 215.4 rounded up
+		{1, 0, 0},          // not configured: no discount
+		{0, 0.1, 0},        // no input price: no discount
+		{1, 2, 1000},       // above input: clamped to full price
+	}
+	for _, c := range cases {
+		got := cachedPermille(&ModelUSD{InputUSDPerMTok: c.in, CachedInputUSDPerMTok: c.cached})
+		if got != c.want {
+			t.Errorf("in %v cached %v: got %d want %d", c.in, c.cached, got, c.want)
+		}
+	}
+}
diff --git a/pricing/pricing.go b/pricing/pricing.go
index c095859..44e25a7 100644
--- a/pricing/pricing.go
+++ b/pricing/pricing.go
@@ -24,11 +24,26 @@ type ModelUSD struct {
 	// tokens.
 	OutputUSDPerMTok float64
 
+	// CachedInputUSDPerMTok is the upstream USD price per million cached
+	// input tokens; zero means no cache discount.
+	CachedInputUSDPerMTok float64
+
 	// BundleTokens overrides the table-wide bundle size for this model
 	// when positive.
 	BundleTokens int64
 }
 
+// cachedPermille is the cached-input price in thousandths of the input
+// price, rounded up so the discount never sells below the upstream ratio.
+// Zero means no discount.
+func cachedPermille(m *ModelUSD) int64 {
+	if m.CachedInputUSDPerMTok <= 0 || m.InputUSDPerMTok <= 0 {
+		return 0
+	}
+	p := int64(math.Ceil(m.CachedInputUSDPerMTok / m.InputUSDPerMTok * 1000))
+	return min(max(p, 1), 1000)
+}
+
