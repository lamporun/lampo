+// Lampo: cached prompt tokens are parsed and clamped to the prompt count.
+func TestCountsFromUsageCachedTokens(t *testing.T) {
+	p, c, cached, over := int64(1000), int64(50), int64(800), int64(5000)
+	u := &usageJSON{PromptTokens: &p, CompletionTokens: &c}
+	u.PromptTokensDetails = &struct {
+		CachedTokens *int64 `json:"cached_tokens"`
+	}{CachedTokens: &cached}
+	got, ok := countsFromUsage(u)
+	if !ok || got.cachedTokens != 800 || got.promptTokens != 1000 {
+		t.Fatalf("got %+v ok=%v", got, ok)
+	}
+	u.PromptTokensDetails.CachedTokens = &over
+	got, _ = countsFromUsage(u)
+	if got.cachedTokens != 1000 {
+		t.Fatalf("cached not clamped: %d", got.cachedTokens)
+	}
+	body := []byte(`{"usage":{"prompt_tokens":10,"completion_tokens":2,"total_tokens":12,"prompt_tokens_details":{"cached_tokens":7}}}`)
+	got, ok = extractUsage("application/json", body)
+	if !ok || got.cachedTokens != 7 {
+		t.Fatalf("json body: %+v ok=%v", got, ok)
+	}
+}
+
+// Lampo: the weighted debit discounts cached tokens and is unchanged without them.
+func TestWeightedDebitCached(t *testing.T) {
+	r := &ModelConfig{InputMsatPerToken: 6, OutputMsatPerToken: 28}
+	base := usageCounts{promptTokens: 1000, completionTokens: 100, hasSplit: true}
+	old, _ := weightedDebit(base, r) // ceil(2*(6000+2800)/34) = 518
+	if old != 518 {
+		t.Fatalf("no-cache debit changed: %d", old)
+	}
+	withCache := base
+	withCache.cachedTokens = 800
+	same, _ := weightedDebit(withCache, r) // permille 0 means no discount
+	if same != old {
+		t.Fatalf("permille 0 must not discount: %d", same)
+	}
+	r.CachedInputPermille = 100
+	got, _ := weightedDebit(withCache, r) // ceil(2*(200*6+800*0.6+100*28)/34) = ceil(8960/34) = 264
+	if got != 264 {
+		t.Fatalf("cached debit: %d", got)
+	}
+}
