 	// OutputMsatPerToken is the price in millisatoshi of a single output
 	// (completion) token.
 	OutputMsatPerToken int64 `yaml:"outputmsatpertoken" long:"outputmsatpertoken" description:"Price in millisatoshi per output token"`
+
+	// CachedInputPermille is the price of a cached input token, in
+	// thousandths of InputMsatPerToken (100 = a tenth of the input price).
+	// Zero, or 1000 and above, means no discount: cached tokens are billed
+	// as fresh input, the historical behavior.
+	CachedInputPermille int64 `yaml:"cachedinputpermille" long:"cachedinputpermille" description:"Price of a cached input token in thousandths of the input price (0 = no discount)"`
+}
+
+// weightedDebit returns the bundle tokens to debit for a request whose
+// prompt/completion split is known. The bundle was priced at the blended
+// (input+output)/2 rate, so each token is charged rate/blend bundle tokens;
+// cached prompt tokens are charged at CachedInputPermille of the input rate.
+// The division rounds up, never favoring the client.
+func weightedDebit(counts usageCounts, rates *ModelConfig) (int64, bool) {
+	rateSum := rates.InputMsatPerToken + rates.OutputMsatPerToken
+	if rateSum <= 0 {
+		return 0, false
+	}
+	permille := rates.CachedInputPermille
+	if permille <= 0 || permille > 1000 {
+		permille = 1000
+	}
+	cached := min(max(counts.cachedTokens, 0), max(counts.promptTokens, 0))
+	fresh := counts.promptTokens - cached
+	weightedTimes2000 := 2 * (fresh*rates.InputMsatPerToken*1000 +
+		cached*rates.InputMsatPerToken*permille +
+		counts.completionTokens*rates.OutputMsatPerToken*1000)
+	den := rateSum * 1000
+	return (weightedTimes2000 + den - 1) / den, true
 }
 
