# Lampo - public entry point. Template rendered by deploy/setup.sh.
# Caddy gets the TLS certificate from Let's Encrypt by itself.
# No general access log is written: we do not keep IP addresses or requests.
# The only log is the partner-link log below, without IPs or request headers.

@DOMAIN@ {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The site has inline script and style, and only talks to itself.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Partner links: /r/<code>/v1/... is the API with a partner's code in
	# front. The code is stripped here, and only these requests are logged,
	# to a file of their own without IP addresses or request headers, so the
	# worker can match the 402 challenges they receive to the bundles bought
	# with them (scripts/partners_worker.py).
	@partner path_regexp partner ^/r/([a-z2-7]{8})(/v1/.*)$
	log_append @partner partner_code {re.partner.1}
	@not_partner not path_regexp ^/r/[a-z2-7]{8}/v1/
	log_skip @not_partner
	rewrite @partner {re.partner.2}
	log partners {
		output file /var/log/caddy/lampo-partners.log {
			roll_size 10MiB
			roll_keep 5
			mode 0644
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				user_id delete
			}
		}
	}

	# A partner's dashboard: @DOMAIN@/r/<code>
	@partner_page path_regexp page ^/r/([a-z2-7]{8})/?$
	redir @partner_page /partners.html?code={re.page.1}

	# Hosted nwc-guard: the connect endpoint (guard-cloud, its own sandboxed service).
	handle /guard/api/* {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:10040
	}

	# Partner program API: sign-up and public stats.
	handle /v1/partners* {
		reverse_proxy 127.0.0.1:10032
	}

	# OpenAI-style model list, served as a static file.
	handle /v1/models {
		root * /srv/lampo/site
		rewrite * /models.json
		file_server
	}

	# Free: tokens left in a bundle, for the holder of its credential.
	handle /v1/balance {
		reverse_proxy 127.0.0.1:10031
	}

	# Paid inference: Aperture on localhost. flush_interval -1 streams
	# tokens to the agent as soon as they arrive.
	handle /v1/* {
		# Every API response, including the 402 with the invoice, points to
		# the terms that paying accepts.
		header Link "<https://@DOMAIN@/terms.html>; rel=\"terms-of-service\""
		header X-Terms-Of-Service "https://@DOMAIN@/terms.html (paying an invoice means accepting these terms)"
		# Large enough for a 1M-token prompt with images; stops oversized bodies early.
		request_body {
			max_size 16MB
		}
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
			# Aperture answers a bare "failure fetching resource price" (often a
			# wrong model id): give clients an OpenAI-style error they can read.
			@failed status 500
			handle_response @failed {
				header Content-Type application/json
				respond `{"error":{"message":"Lampo could not complete this request. Most often the model id is not one we sell: see https://lampo.run/v1/models (for example deepseek-ai/DeepSeek-V4-Flash-0731). If you already paid, your credential keeps working: just retry. If it keeps failing, write to contact@lampo.run.","type":"lampo_error","code":"request_failed"}}` 500
			}
		}
	}

	# Website: instructions, prices, live counter, terms, privacy.
	handle {
		# NIP-05: Nostr clients fetch this from the browser, so allow any origin.
		header /.well-known/nostr.json Access-Control-Allow-Origin "*"
		root * /srv/lampo/site
		encode zstd gzip
		file_server
	}
}

www.@DOMAIN@ {
	redir https://@DOMAIN@{uri} permanent
}
