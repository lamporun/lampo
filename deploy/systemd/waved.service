[Unit]
Description=Lampo - Wavelength wallet (waved)
Wants=network-online.target
After=network-online.target
OnFailure=lampo-alert@%n.service

[Service]
User=lampo
Group=lampo
ExecStart=/opt/lampo/bin/run-waved.sh
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lampo

[Install]
WantedBy=multi-user.target
